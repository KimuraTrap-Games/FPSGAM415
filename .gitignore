#############################################
# 🛠️ Unreal Engine 5 Git Ignore Template
#############################################

# IDEs and Development Tools
.vs/
.vsconfig
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic Libraries
*.so
*.dylib
*.dll

# Compiled Static Libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Fortran module files
*.mod

#############################################
# 🚫 Unreal Engine Generated Content
#############################################

# Engine-generated binaries and intermediate files
Binaries/*
Build/*
Intermediate/*
DerivedDataCache/*
Saved/*

# Plugin binaries and intermediates
Plugins/**/Binaries/*
Plugins/**/Intermediate/*

# Keep important PakBlacklist files
!Build/*/
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Map build data (can be very large)
*_BuiltData.uasset

#############################################
# 🎨 Source Art (Optional, based on workflow)
#############################################
SourceArt/**/*.png
SourceArt/**/*.tga

#############################################
# 🪶 Optional User Config Files (team decision)
#############################################
Config/DefaultEditorPerProjectUserSettings.ini
Config/DefaultEditor.ini

#############################################
# 🍎 macOS & Windows System Files
#############################################
.DS_Store
Thumbs.db
ehthumbs.db

#############################################
# 💡 Notes:
# - DO track .uproject and Config/ folder (except user-specific ones above)
# - DO NOT track auto-generated files or cached data
# - Use Git LFS for .uasset, .umap, and large binary files
#############################################
